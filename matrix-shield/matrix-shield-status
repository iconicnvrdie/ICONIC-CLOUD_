#!/usr/bin/env bash
# Matrix Shield — live DDoS protection status (qwen-filter engine)
# Usage: matrix-shield [--motd] [--json]
# Env: METRICS_URL (default http://127.0.0.1:1999/metrics)
set -euo pipefail

METRICS_URL="${METRICS_URL:-http://127.0.0.1:1999/metrics}"
BANNER="/etc/matrix-shield/banner.txt"
SVC="qwen-filter.service"

if [ ! -t 1 ] && [ "${TERM:-dumb}" = "dumb" ]; then
  : 
fi

fmt_num() { awk -v n="$1" 'BEGIN{
  if (n+0 >= 1000000000) printf "%.2fB", n/1e9;
  else if (n+0 >= 1000000) printf "%.2fM", n/1e6;
  else if (n+0 >= 1000) printf "%.2fK", n/1e3;
  else printf "%.0f", n;}'; }
fmt_bw()  { awk -v n="$1" 'BEGIN{
  split("B K M G T",u," ");
  i=1; v=n+0; while(v>=1024 && i<5){v/=1024;i++}
  printf "%.1f %s", v, u[i];}'; }

get() { awk -v key="xdpguard_$1" '$1==key && NF==2 {print $2; exit}' <<<"$DATA"; }

DATA="$(curl -fsS --max-time 5 "$METRICS_URL" 2>/dev/null || true)"

STATE="$(systemctl is-active "$SVC" 2>/dev/null || echo unknown)"
IFACE="$(awk -F'[ =]' '/^ExecStart=/{for(i=1;i<=NF;i++){p=$i; if(p!="ExecStart" && p!="-" && substr(p,1,1)!="-" && substr(p,1,1)!="/" && p!=""){print p; exit}}}' "/etc/systemd/system/$SVC" 2>/dev/null || true)"
[ -n "$IFACE" ] || IFACE=auto
UPTIME="$(systemctl show "$SVC" -p ActiveEnterTimestamp --value 2>/dev/null | sed 's/^[A-Za-z]* //')"

b() { get "$1"; }
BLOCKED_ACT="$(b active_blocked_ips)";   [ -n "$BLOCKED_ACT" ] || BLOCKED_ACT=0
BLOCKED_TOT="$(b blocked_ips)";          [ -n "$BLOCKED_TOT" ] || BLOCKED_TOT=0
DROP_PKT="$(b dropped_packets)";         [ -n "$DROP_PKT" ] || DROP_PKT=0
DROP_PPS="$(b dropped_pps)";             [ -n "$DROP_PPS" ] || DROP_PPS=0
DROP_BYTES="$(b dropped_bytes)";         [ -n "$DROP_BYTES" ] || DROP_BYTES=0
DROP_BPS="$(b dropped_bps)";             [ -n "$DROP_BPS" ] || DROP_BPS=0
PASS_PKT="$(b passed_packets)";          [ -n "$PASS_PKT" ] || PASS_PKT=0
PASS_PPS="$(b passed_pps)";              [ -n "$PASS_PPS" ] || PASS_PPS=0

if [ "${1:-}" = "--json" ]; then
  printf '{"filter":"qwen-filter","engine":"xdp","name":"Matrix Shield","service":"%s","interface":"%s","uptime":"%s","blocked_active":%s,"blocked_total":%s,"dropped_packets":%s,"dropped_pps":%s,"dropped_bytes":%s,"dropped_bps":%s,"passed_packets":%s,"passed_pps":%s}\n' \
    "$STATE" "$IFACE" "$UPTIME" "$BLOCKED_ACT" "$BLOCKED_TOT" "$DROP_PKT" "$DROP_PPS" "$DROP_BYTES" "$DROP_BPS" "$PASS_PKT" "$PASS_PPS"
  exit 0
fi

if [ "${1:-}" = "--motd" ]; then
  [ -f "$BANNER" ] && cat "$BANNER"
  case "$STATE" in
    active)  printf "       \033[32m[ ACTIVE ]\033[0m  Shield is UP | %s blocked IPs | %s packets dropped\n" "$(fmt_num "$BLOCKED_ACT")" "$(fmt_num "$DROP_PKT")" ;;
    *)       printf "       \033[31m[ DOWN ]\033[0m  Filter is not running!\n" ;;
  esac
  exit 0
fi

if [ -t 1 ]; then
  B="\033[1;32m"; C="\033[1;36m"; D="\033[0;90m"; R="\033[0m"; Y="\033[1;33m"; GRN="\033[32m"; RED="\033[31m"
  ACT="${GRN}● ACTIVE${R}"; IN="${RED}● DOWN${R}"
else
  B="";C="";D="";R="";Y="";GRN="";RED="";ACT="ACTIVE";IN="DOWN"
fi

[ -f "$BANNER" ] && cat "$BANNER"
PUB_IP="$(curl -fsS --max-time 2 https://ifconfig.me 2>/dev/null || true)"
[ -n "$PUB_IP" ] || PUB_IP="$(hostname -I 2>/dev/null | awk '{print $1}')"
echo -e "${D}----------------------------------------------------------------------${R}"
case "$STATE" in
  active)  echo -e "  Filter          : ${ACT}   interface ${C}${IFACE}${R}   uptime ${Y}${UPTIME}${R}" ;;
  *)       echo -e "  Filter          : ${IN}   (systemctl start ${C}${SVC}${R})" ;;
esac
echo -e "  Dashboard       : ${C}http://${PUB_IP:-<vps-ip>}:9090${R}   cmd ${C}matrix-shield${R}"
echo -e "  Metrics         : ${D}${METRICS_URL}${R}"
echo -e "${D}----------------------------------------------------------------------${R}"
printf "  \033[1m%s %12s %12s %12s%*s\033[0m\n" "THREATS BLOCKED" "TOTAL" "PER-SEC" "RATE" 0 ""
echo -e "  ${Y}Attack surface${R}: SYN flood + UDP amplification + fragments + bogon + L7 + TLS + ICMP + FIN/RST + SSH brute"

printf "  %-18s %14s %12s\n" "Blocked IPs"     "$(fmt_num "$BLOCKED_ACT") active" "$(fmt_num "$BLOCKED_TOT") total"
printf "  %-18s %14s %12s\n" "Dropped"         "$(fmt_num "$DROP_PKT") pkts"   "$(fmt_num "$DROP_PPS") pps"
printf "  %-18s %14s %12s\n" "Dropped volume"  "$(fmt_bw "$DROP_BYTES")"        "$(fmt_bw "$DROP_BPS")/s"
printf "  %-18s %14s %12s\n" "Passed (legit)"  "$(fmt_num "$PASS_PKT") pkts"   "$(fmt_num "$PASS_PPS") pps"

for cat in syn:syn_rate_dropped:SYN flood udp:udp_amp_dropped:UDP amplification frag:frag_dropped:Fragment \
           bog:bogon_dropped:Bogon l7:l7_rate_dropped:L7 abuse tls:tls_dropped:TLS handshake \
           icmp:icmp_dropped:ICMP flood fin:fin_rst_dropped:SYN/FIN attack ack:ack_invalid:ACK invalid \
           win:window_dropped:Window scrub ssh:ssh_dropped:SSH brute rst:rst_invalid:RST invalid; do
  id="${cat%%:*}"; rest="${cat#*:}"; m="${rest%%:*}"; name="${rest#*:}"
  tot="$(b "$m")"; [ -n "$tot" ] && [ "$tot" != "0" ] || continue
  pps="$(b "${m}_per_sec")"; [ "$tot" = "0" ] && [ -n "$pps" ] && [ "$pps" != "0" ] && continue
  printf "  %-9s %14s %12s\n" "$id:" "$(fmt_num "$tot")" "$(fmt_num "$pps")/s"
done

echo -e "${D}----------------------------------------------------------------------${R}"
echo -e "  ${C}matrix-shield --json${R}  machine stats   ${C}journalctl -u ${SVC} -f${R}  live engine logs"